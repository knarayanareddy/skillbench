{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/Review.json",
  "title": "Review",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "extraction_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "ReviewPatch.json"
      }
    }
  },
  "required": [
    "id",
    "extraction_id",
    "revision",
    "base_revision",
    "actor_id",
    "created_at",
    "patches"
  ],
  "additionalProperties": false
}
