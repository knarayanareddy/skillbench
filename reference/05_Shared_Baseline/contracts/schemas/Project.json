{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/Project.json",
  "title": "Project",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "content_capture": {
      "type": "string",
      "enum": [
        "metadata_only",
        "redacted"
      ]
    },
    "external_transfer": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "name",
    "content_capture",
    "external_transfer",
    "revision",
    "created_at"
  ],
  "additionalProperties": false
}
