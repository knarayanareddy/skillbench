{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/Actor.json",
  "title": "Actor",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "viewer",
          "analyst",
          "operator",
          "maintainer",
          "admin"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "user_id",
    "organization_id",
    "roles"
  ],
  "additionalProperties": false
}
