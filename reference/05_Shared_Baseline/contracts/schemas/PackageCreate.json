{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/PackageCreate.json",
  "title": "PackageCreate",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "license_expression": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "artifact_id",
    "name"
  ],
  "additionalProperties": false
}
