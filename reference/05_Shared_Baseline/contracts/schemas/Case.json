{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/Case.json",
  "title": "Case",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "afr-case/1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "definition": {
      "$ref": "CaseCreate.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "project_id",
    "schema_version",
    "version",
    "manifest_sha256",
    "definition",
    "created_at"
  ],
  "additionalProperties": false
}
