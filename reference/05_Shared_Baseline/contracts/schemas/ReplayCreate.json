{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/ReplayCreate.json",
  "title": "ReplayCreate",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "visual",
        "recorded"
      ]
    },
    "maximum_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    }
  },
  "required": [
    "case_id",
    "case_version",
    "mode",
    "maximum_seconds"
  ],
  "additionalProperties": false
}
