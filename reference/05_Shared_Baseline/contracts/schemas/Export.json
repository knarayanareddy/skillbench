{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/Export.json",
  "title": "Export",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "extraction_id": {
      "type": "string",
      "format": "uuid"
    },
    "review_revision": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "incomplete": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "project_id",
    "extraction_id",
    "review_revision",
    "artifact_id",
    "manifest_sha256",
    "incomplete",
    "warnings",
    "created_at"
  ],
  "additionalProperties": false
}
