{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/ReplayResult.json",
  "title": "ReplayResult",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error",
        "unscored"
      ]
    },
    "network_calls": {
      "const": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "error"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "index",
          "outcome",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "id",
    "job_id",
    "case_id",
    "state",
    "network_calls",
    "checks",
    "manifest_sha256"
  ],
  "additionalProperties": false
}
