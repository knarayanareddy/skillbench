{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseline.invalid/schemas/Plan.json",
  "title": "Plan",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "preregistered"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "definition": {
      "$ref": "PlanCreate.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "project_id",
    "sha256",
    "state",
    "revision",
    "definition",
    "created_at"
  ],
  "additionalProperties": false
}
